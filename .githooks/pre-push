#!/bin/sh
# Abort a push if any pushed commit message carries Claude/Anthropic attribution.
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
patterns="$(git rev-parse --show-toplevel)/.githooks/attribution-patterns"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  # Branch deletion: nothing to check.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;
    *) range="$local_sha" ;; # new ref: check full history
  esac
  if git log --format=%B "$range" | grep -Eiq -f "$patterns"; then
    echo "pre-push: rejected $local_ref -> $remote_ref. Attribution found in $range:" >&2
    git log --format=%B "$range" | grep -Ei -f "$patterns" | sed 's/^/  /' >&2
    status=1
  fi
done

count=$(git log --format=%B | grep -ci 'co-authored-by:.*claude')
if [ "$count" != "0" ]; then
  echo "pre-push: rejected. HEAD history has $count Claude co-author line(s)." >&2
  status=1
fi

exit $status
