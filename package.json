{
  "name": "temple-of-aphaia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "prepare": "git config core.hooksPath .githooks",
    "copy-scan": "sh tools/measure/copy_scan.sh",
    "bake": "vite-node tools/bake/bake.ts --",
    "measure:venv": "python3 -m venv tools/measure/.venv && tools/measure/.venv/bin/pip install -r tools/measure/requirements.txt",
    "measure:test": "tools/measure/.venv/bin/python -m pytest tools/measure/tests",
    "measure:up": "tools/measure/.venv/bin/python -I tools/measure/up.py scan/aigina.ply",
    "measure:views": "tools/measure/.venv/bin/python -I tools/measure/render_views.py scan/aigina.ply --crop=-24,12,-13,8 --res 0.04 --slice 2.6,3.6 --rows \"north:y:3.3:5.3;south:y:-10.5:-7;west:x:-21.5:-19.3;east:x:7:9\"",
    "measure:picks": "tools/measure/.venv/bin/python -I tools/measure/save_picks.py scan/aigina.ply",
    "measure:run": "tools/measure/.venv/bin/python -I tools/measure/measure_from_picks.py scan/aigina.ply --bootstrap 1000",
    "measure:merge": "tools/measure/.venv/bin/python -I tools/measure/merge_dimensions.py",
    "measure:terrain": "tools/measure/.venv/bin/python -I tools/measure/terrain.py scan/aigina.ply",
    "measure:sanctuary": "tools/measure/.venv/bin/python -I tools/measure/sanctuary_plan.py refs/incoming/Plan_Aphaia_sanctuary-en.svg"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "lighthouse": "^12.8.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "~8.72.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "detect-gpu": "^5.0.70",
    "three": "^0.187.0"
  },
  "engines": {
    "node": ">=22"
  }
}
