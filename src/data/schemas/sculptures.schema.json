{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sculptures.schema.json",
  "title": "Scanned sculptures replacing stand-ins",
  "type": "object",
  "required": [
    "meta",
    "lodTriangles",
    "sculptures"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "status",
        "note"
      ]
    },
    "lodTriangles": {
      "type": "object",
      "required": [
        "high",
        "low"
      ],
      "additionalProperties": false,
      "properties": {
        "high": {
          "type": "integer",
          "minimum": 1000
        },
        "low": {
          "type": "integer",
          "minimum": 500
        }
      }
    },
    "sculptures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "slot",
          "kind",
          "paint"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "pediment",
                  "figureId"
                ],
                "additionalProperties": false,
                "properties": {
                  "pediment": {
                    "enum": [
                      "west",
                      "east"
                    ]
                  },
                  "figureId": {
                    "$ref": "common.schema.json#/definitions/id"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "site"
                ],
                "additionalProperties": false,
                "properties": {
                  "site": {
                    "enum": [
                      "cella-cult-statue",
                      "sphinx-column"
                    ]
                  }
                }
              }
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "sourceId",
              "objectNumber",
              "page",
              "file"
            ],
            "additionalProperties": false,
            "properties": {
              "sourceId": {
                "$ref": "common.schema.json#/definitions/id"
              },
              "objectNumber": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "string",
                "pattern": "^https?://"
              },
              "file": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          },
          "original": {
            "type": "object",
            "required": [
              "position",
              "date",
              "museum"
            ],
            "additionalProperties": false,
            "properties": {
              "position": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "museum": {
                "type": "string"
              }
            }
          },
          "restoration": {
            "enum": [
              "thorvaldsen",
              "none",
              "uncertain"
            ]
          },
          "scan": {
            "type": "object",
            "required": [
              "file",
              "up",
              "facingDeg"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "up": {
                "enum": [
                  "+x",
                  "-x",
                  "+y",
                  "-y",
                  "+z",
                  "-z"
                ]
              },
              "facingDeg": {
                "type": "number"
              },
              "heightM": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unitToMetre": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "oneOf": [
              {
                "required": [
                  "heightM"
                ]
              },
              {
                "required": [
                  "unitToMetre"
                ]
              }
            ]
          },
          "paint": {
            "enum": [
              "marble",
              "scythian-costume"
            ]
          },
          "note": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "real",
              "mirrored",
              "imagined"
            ]
          },
          "asset": {
            "$ref": "common.schema.json#/definitions/id",
            "description": "id of the real entry whose processed scan this slot reuses"
          },
          "mirror": {
            "type": "boolean"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "Label: 'mirrored from <slot>' or 'imagined from <figure>'"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "licence": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "real"
                }
              }
            },
            "then": {
              "required": [
                "source",
                "original",
                "restoration",
                "scan"
              ],
              "not": {
                "required": [
                  "asset"
                ]
              }
            },
            "else": {
              "required": [
                "asset",
                "mirror",
                "from"
              ],
              "not": {
                "required": [
                  "scan"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
