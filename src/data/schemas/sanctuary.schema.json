{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sanctuary.schema.json",
  "title": "Sanctuary features",
  "description": "Primary values for the sanctuary around the temple (plan Step 3b). Coordinates are metres in the temple frame (x east, z south, origin at the stylobate centre). Levels (terrace levels, baseLevel) are metres relative to the stylobate top. The scan covers only the temple, so every feature is placed from the published site plan (placement.source = plan) and the terrain is a sparse, conjectural description: terrace polygons, retaining walls (wall features, role terrace) and a directional hill falloff beyond the terraces.",
  "type": "object",
  "required": [
    "meta",
    "temple",
    "terrain",
    "features",
    "hidden"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "required": [
        "status",
        "note",
        "displayYear",
        "displayLabel"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "provisional",
            "merged"
          ]
        },
        "note": {
          "type": "string"
        },
        "displayYear": {
          "type": "integer",
          "description": "Year shown (negative = BCE). Features whose phase spans it are shown."
        },
        "displayLabel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "temple": {
      "type": "object",
      "required": [
        "foundationDepth",
        "rampWidth"
      ],
      "additionalProperties": false,
      "properties": {
        "foundationDepth": {
          "$ref": "#/definitions/positive",
          "description": "Depth of the krepis foundation skirt below the lowest step's base (m)."
        },
        "rampWidth": {
          "$ref": "#/definitions/positive"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "terrain": {
      "$ref": "#/definitions/terrain"
    },
    "features": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/definitions/id"
      },
      "additionalProperties": {
        "$ref": "#/definitions/feature"
      }
    },
    "hidden": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/definitions/id"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "phase",
          "sourceIds",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "$ref": "#/definitions/phase"
          },
          "sourceIds": {
            "$ref": "common.schema.json#/definitions/sourceIds"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "measure": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "source",
        "ref",
        "verified"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "m",
            "deg",
            "count",
            "ratio"
          ]
        },
        "source": {
          "enum": [
            "published",
            "plan"
          ],
          "description": "published = read in the text; plan = measured on the digitised site plan."
        },
        "ref": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "verified": {
          "type": "boolean"
        },
        "provisional": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/noPageUnlessVerified"
        },
        {
          "if": {
            "properties": {
              "provisional": {
                "const": true
              }
            },
            "required": [
              "provisional"
            ]
          },
          "then": {
            "properties": {
              "verified": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "positive": {
      "allOf": [
        {
          "$ref": "#/definitions/measure"
        },
        {
          "properties": {
            "value": {
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "nonNegative": {
      "allOf": [
        {
          "$ref": "#/definitions/measure"
        },
        {
          "properties": {
            "value": {
              "minimum": 0
            }
          }
        }
      ]
    },
    "count": {
      "allOf": [
        {
          "$ref": "#/definitions/measure"
        },
        {
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "unit": {
              "const": "count"
            }
          }
        }
      ]
    },
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "polyline": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/point"
      },
      "minItems": 2
    },
    "side": {
      "enum": [
        "n",
        "s",
        "e",
        "w"
      ]
    },
    "placement": {
      "type": "object",
      "required": [
        "source",
        "ref",
        "verified",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "plan",
          "description": "The scan covers only the temple: positions and footprints come from the published site plan."
        },
        "ref": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "boolean"
        },
        "confidence": {
          "$ref": "confidence.schema.json"
        },
        "uncertaintyM": {
          "type": "number",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/noPageUnlessVerified"
        }
      ]
    },
    "phase": {
      "type": "object",
      "required": [
        "label",
        "fromYear",
        "toYear",
        "confidence",
        "sourceIds"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "fromYear": {
          "type": [
            "integer",
            "null"
          ]
        },
        "toYear": {
          "type": [
            "integer",
            "null"
          ]
        },
        "confidence": {
          "$ref": "confidence.schema.json"
        },
        "sourceIds": {
          "$ref": "common.schema.json#/definitions/sourceIds"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "door": {
      "type": "object",
      "required": [
        "offset",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "wall": {
          "$ref": "#/definitions/side"
        },
        "offset": {
          "type": "number",
          "description": "Door centre along the wall from its midpoint (local m)."
        },
        "width": {
          "$ref": "#/definitions/positive"
        },
        "height": {
          "$ref": "#/definitions/positive"
        }
      }
    },
    "falloffOverride": {
      "type": "object",
      "required": [
        "edgeDrop",
        "slope"
      ],
      "additionalProperties": false,
      "properties": {
        "edgeDrop": {
          "$ref": "#/definitions/nonNegative"
        },
        "slope": {
          "$ref": "#/definitions/nonNegative"
        }
      }
    },
    "terrain": {
      "type": "object",
      "required": [
        "confidence",
        "sourceIds",
        "terraces",
        "falloff"
      ],
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "const": "conjectural",
          "description": "The terrain shape is a reconstruction, not a survey."
        },
        "sourceIds": {
          "$ref": "common.schema.json#/definitions/sourceIds"
        },
        "note": {
          "type": "string"
        },
        "terraces": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "polygon",
              "level"
            ],
            "additionalProperties": false,
            "properties": {
              "polygon": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/point"
                },
                "minItems": 3
              },
              "level": {
                "$ref": "#/definitions/measure"
              },
              "falloff": {
                "$ref": "#/definitions/falloffOverride"
              },
              "note": {
                "type": "string"
              },
              "hiddenReason": {
                "type": "string",
                "minLength": 1,
                "description": "Listed but not depicted (user decision): left out of the terrain."
              },
              "edgeFace": {
                "enum": [
                  "rubble",
                  "ashlar",
                  "older",
                  "rock"
                ],
                "description": "Material of this terrace's exposed edge faces (retaining masonry or rock); default rubble."
              },
              "edgeFaces": {
                "type": "array",
                "items": {
                  "enum": [
                    "rubble",
                    "ashlar",
                    "older",
                    "rock"
                  ]
                },
                "description": "Per polygon edge (edge i runs from point i to i + 1); overrides edgeFace."
              },
              "clampDrop": {
                "$ref": "#/definitions/nonNegative",
                "description": "Overrides terrain.dem.nearTerraceClamp.drop next to this terrace."
              },
              "fillDrop": {
                "$ref": "#/definitions/nonNegative",
                "description": "Conjectural fill next to this terrace: within the DEM clamp's radius the ground is raised to at most this far below it, feathered back."
              }
            }
          }
        },
        "falloff": {
          "type": "object",
          "required": [
            "edgeDrop",
            "slope",
            "radius"
          ],
          "additionalProperties": false,
          "properties": {
            "edgeDrop": {
              "type": "object",
              "required": [
                "n",
                "e",
                "s",
                "w"
              ],
              "additionalProperties": false,
              "properties": {
                "n": {
                  "$ref": "#/definitions/measure"
                },
                "e": {
                  "$ref": "#/definitions/measure"
                },
                "s": {
                  "$ref": "#/definitions/measure"
                },
                "w": {
                  "$ref": "#/definitions/measure"
                }
              },
              "description": "Drop of the natural ground just outside a terrace edge, by outward direction (m)."
            },
            "slope": {
              "type": "object",
              "required": [
                "n",
                "e",
                "s",
                "w"
              ],
              "additionalProperties": false,
              "properties": {
                "n": {
                  "$ref": "#/definitions/measure"
                },
                "e": {
                  "$ref": "#/definitions/measure"
                },
                "s": {
                  "$ref": "#/definitions/measure"
                },
                "w": {
                  "$ref": "#/definitions/measure"
                }
              },
              "description": "Ground slope beyond the edge drop, by outward direction (ratio); it doubles by the radius."
            },
            "radius": {
              "$ref": "#/definitions/positive"
            }
          }
        },
        "dem": {
          "type": "object",
          "required": [
            "file",
            "ref",
            "verified"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "$ref": "common.schema.json#/definitions/id"
            },
            "verified": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            },
            "nearTerraceClamp": {
              "type": "object",
              "required": [
                "radius",
                "drop"
              ],
              "additionalProperties": false,
              "properties": {
                "radius": {
                  "$ref": "#/definitions/positive"
                },
                "drop": {
                  "$ref": "#/definitions/positive"
                },
                "note": {
                  "type": "string"
                },
                "hold": {
                  "$ref": "#/definitions/positive"
                }
              },
              "description": "Conjectural correction of the DSM next to the terraces: within radius of a terrace edge the natural ground is held at least drop below that terrace, feathered back to the DEM."
            }
          }
        }
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "phase",
        "placement",
        "sourceIds",
        "confidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "houses",
            "altar",
            "base",
            "building",
            "wall",
            "cistern",
            "channel",
            "pavement",
            "column"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "$ref": "#/definitions/phase"
        },
        "placement": {
          "$ref": "#/definitions/placement"
        },
        "sourceIds": {
          "$ref": "common.schema.json#/definitions/sourceIds"
        },
        "confidence": {
          "$ref": "confidence.schema.json"
        },
        "note": {
          "type": "string"
        },
        "baseLevel": {
          "type": "number",
          "description": "Fixed base level relative to the stylobate top (m); otherwise the base follows the terrain."
        },
        "uncertain": {
          "type": "string",
          "minLength": 1,
          "description": "Shown, but its existence or form at the display date is uncertain (About panel)."
        },
        "complex": {
          "$ref": "common.schema.json#/definitions/id",
          "description": "Group of adjoining features (e.g. the SE houses) whose footprints may touch."
        },
        "hiddenReason": {
          "type": "string",
          "minLength": 1,
          "description": "Listed but not depicted whatever the display date (user decision); shown in the About panel."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "houses"
              }
            }
          },
          "then": {
            "required": [
              "blocks"
            ],
            "properties": {
              "kind": true,
              "name": true,
              "phase": true,
              "placement": true,
              "sourceIds": true,
              "confidence": true,
              "note": true,
              "baseLevel": true,
              "uncertain": true,
              "complex": true,
              "hiddenReason": true,
              "blocks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "center",
                    "rotation",
                    "length",
                    "width",
                    "eaveHeight",
                    "roofRise",
                    "overhang"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "$ref": "common.schema.json#/definitions/id"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "center": {
                      "$ref": "#/definitions/point"
                    },
                    "rotation": {
                      "type": "number",
                      "description": "Degrees about +y, counter-clockwise seen from above (local x turns toward north)."
                    },
                    "length": {
                      "$ref": "#/definitions/positive"
                    },
                    "width": {
                      "$ref": "#/definitions/positive"
                    },
                    "eaveHeight": {
                      "$ref": "#/definitions/positive"
                    },
                    "roofRise": {
                      "$ref": "#/definitions/positive"
                    },
                    "overhang": {
                      "$ref": "#/definitions/nonNegative"
                    },
                    "roof": { "enum": ["hipped", "shed"] },
                    "porch": {
                      "type": "object",
                      "required": ["columns", "depth", "endWall"],
                      "additionalProperties": false,
                      "properties": {
                        "columns": { "type": "integer", "minimum": 1 },
                        "depth": { "$ref": "#/definitions/positive" },
                        "endWall": { "$ref": "#/definitions/positive" }
                      },
                      "description": "Open colonnade on the -x face, a solid end wall (length endWall) at +z."
                    }
                  },
                  "description": "A walled block under a hipped roof (four equal pitches, ridge along the longer side)."
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "altar"
              }
            }
          },
          "then": {
            "required": [
              "center",
              "rotation",
              "length",
              "width",
              "height"
            ],
            "properties": {
              "kind": true,
              "name": true,
              "phase": true,
              "placement": true,
              "sourceIds": true,
              "confidence": true,
              "note": true,
              "baseLevel": true,
              "uncertain": true,
              "complex": true,
              "center": {
                "$ref": "#/definitions/point"
              },
              "rotation": {
                "type": "number",
                "description": "Degrees about +y, counter-clockwise seen from above (local x turns toward north)."
              },
              "length": {
                "$ref": "#/definitions/positive"
              },
              "width": {
                "$ref": "#/definitions/positive"
              },
              "height": {
                "$ref": "#/definitions/positive"
              },
              "steps": {
                "type": "object",
                "required": [
                  "count",
                  "rise",
                  "tread",
                  "side"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "$ref": "#/definitions/count"
                  },
                  "rise": {
                    "$ref": "#/definitions/positive"
                  },
                  "tread": {
                    "$ref": "#/definitions/positive"
                  },
                  "side": {
                    "$ref": "#/definitions/side"
                  }
                }
              },
              "hiddenReason": true,
              "backScreen": {
                "type": "object",
                "required": [
                  "height",
                  "thickness"
                ],
                "additionalProperties": false,
                "properties": {
                  "height": {
                    "$ref": "#/definitions/positive"
                  },
                  "thickness": {
                    "$ref": "#/definitions/positive"
                  }
                },
                "description": "Raised rear screen on the side opposite the steps."
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "base"
              }
            }
          },
          "then": {
            "required": [
              "center",
              "rotation",
              "length",
              "width",
              "height"
            ],
            "properties": {
              "kind": true,
              "name": true,
              "phase": true,
              "placement": true,
              "sourceIds": true,
              "confidence": true,
              "note": true,
              "baseLevel": true,
              "uncertain": true,
              "complex": true,
              "center": {
                "$ref": "#/definitions/point"
              },
              "rotation": {
                "type": "number",
                "description": "Degrees about +y, counter-clockwise seen from above (local x turns toward north)."
              },
              "length": {
                "$ref": "#/definitions/positive"
              },
              "width": {
                "$ref": "#/definitions/positive"
              },
              "height": {
                "$ref": "#/definitions/positive"
              },
              "hiddenReason": true,
              "figure": {
                "type": "object",
                "required": [
                  "height",
                  "width",
                  "depth"
                ],
                "additionalProperties": false,
                "properties": {
                  "height": {
                    "$ref": "#/definitions/positive"
                  },
                  "width": {
                    "$ref": "#/definitions/positive"
                  },
                  "depth": {
                    "$ref": "#/definitions/positive"
                  }
                },
                "description": "Placeholder block for the statue on top."
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "building"
              }
            }
          },
          "then": {
            "required": [
              "role",
              "center",
              "rotation",
              "length",
              "width",
              "wallHeight",
              "wallThickness",
              "doors"
            ],
            "properties": {
              "kind": true,
              "name": true,
              "phase": true,
              "placement": true,
              "sourceIds": true,
              "confidence": true,
              "note": true,
              "baseLevel": true,
              "uncertain": true,
              "complex": true,
              "role": {
                "enum": [
                  "propylon",
                  "house",
                  "bath",
                  "ancillary",
                  "other"
                ]
              },
              "center": {
                "$ref": "#/definitions/point"
              },
              "rotation": {
                "type": "number"
              },
              "length": {
                "$ref": "#/definitions/positive"
              },
              "width": {
                "$ref": "#/definitions/positive"
              },
              "wallHeight": {
                "$ref": "#/definitions/positive"
              },
              "wallThickness": {
                "$ref": "#/definitions/positive"
              },
              "doors": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/door"
                }
              },
              "openSides": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/side"
                },
                "uniqueItems": true
              },
              "crossWalls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "axis",
                    "offset",
                    "from",
                    "to",
                    "thickness",
                    "doors"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "axis": {
                      "enum": [
                        "x",
                        "z"
                      ],
                      "description": "Local axis the wall runs along."
                    },
                    "offset": {
                      "type": "number"
                    },
                    "from": {
                      "type": "number"
                    },
                    "to": {
                      "type": "number"
                    },
                    "thickness": {
                      "$ref": "#/definitions/positive"
                    },
                    "doors": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/door"
                      }
                    }
                  }
                }
              },
              "columns": {
                "type": "object",
                "required": [
                  "shape",
                  "diameter",
                  "positions"
                ],
                "additionalProperties": false,
                "properties": {
                  "shape": {
                    "enum": [
                      "octagonal",
                      "round",
                      "square"
                    ]
                  },
                  "diameter": {
                    "$ref": "#/definitions/positive"
                  },
                  "positions": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/point"
                    },
                    "minItems": 1
                  }
                }
              },
              "architraves": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "axis",
                    "offset",
                    "from",
                    "to",
                    "depth",
                    "height"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "axis": {
                      "enum": [
                        "x",
                        "z"
                      ]
                    },
                    "offset": {
                      "type": "number"
                    },
                    "from": {
                      "type": "number"
                    },
                    "to": {
                      "type": "number"
                    },
