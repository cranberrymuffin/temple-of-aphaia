{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pediments.schema.json",
  "title": "Pediment compositions (v1 stand-ins)",
  "type": "object",
  "required": ["meta", "west", "eastOptions", "eastDisplayed"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": { "type": "object", "required": ["status", "note"] },
    "west": { "$ref": "#/definitions/composition" },
    "eastOptions": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/definitions/composition" }
    },
    "eastDisplayed": { "$ref": "common.schema.json#/definitions/id" }
  },
  "definitions": {
    "composition": {
      "type": "object",
      "required": ["id", "label", "sourceIds", "confidence", "figures"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/id" },
        "label": { "type": "string", "minLength": 1 },
        "date": { "type": "string" },
        "sourceIds": { "$ref": "common.schema.json#/definitions/sourceIds" },
        "confidence": { "$ref": "confidence.schema.json" },
        "note": { "type": "string" },
        "figures": { "type": "array", "items": { "$ref": "#/definitions/figure" } }
      }
    },
    "figure": {
      "type": "object",
      "required": ["id", "pose", "x", "sourceIds", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/id" },
        "pose": { "enum": ["standing", "striding", "lunging", "kneeling-archer", "fallen"] },
        "x": { "type": "number", "minimum": -1, "maximum": 1, "description": "Position along the tympanum base, -1 (left/south) to 1 (right/north)." },
        "facing": { "enum": ["left", "right", "front"] },
        "nameId": { "$ref": "common.schema.json#/definitions/id" },
        "sourceIds": { "$ref": "common.schema.json#/definitions/sourceIds" },
        "confidence": { "$ref": "confidence.schema.json" },
        "note": { "type": "string" }
      }
    }
  }
}
