{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/id" }
    },
    "noPageUnlessVerified": {
      "description": "An unverified entry must not carry a page/plate number (never invent page numbers).",
      "if": { "properties": { "verified": { "const": false } }, "required": ["verified"] },
      "then": { "not": { "required": ["page"] } }
    }
  }
}
